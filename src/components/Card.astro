---
interface Props {
	title: string;
	meta?: string;
	tags?: string[];
	image?: string;
	imageAlt?: string;
	hoverImage?: string;
	hoverImageAlt?: string;
	links?: { label: string; href: string }[];
	href?: string;
	filterTypes?: string[];
	titleIcon?: 'steam' | 'itch';
	platformIcons?: ('windows' | 'mac' | 'browser')[];
	allRoles?: string[];
}

const {
	title,
	meta,
	tags = [],
	image,
	imageAlt = '',
	hoverImage,
	hoverImageAlt = '',
	links = [],
	href,
	filterTypes = [],
	titleIcon,
	platformIcons = [],
	allRoles = [],
} = Astro.props;
---

<article
	class:list={['card', image && 'card--with-media']}
	data-types={filterTypes.join('|')}
>
	{
		image && (
			<div class:list={['card__media', hoverImage && 'card__media--swap']}>
				{href ? (
					<a href={href} aria-label={`View ${title}`}>
						<img class="card__image card__image--splash" src={image} alt={imageAlt} loading="eager" />
						{hoverImage && (
							<img
								class="card__image card__image--hover"
								src={hoverImage}
								alt={hoverImageAlt}
								loading="eager"
								aria-hidden={hoverImageAlt ? undefined : 'true'}
							/>
						)}
					</a>
				) : (
					<>
						<img class="card__image card__image--splash" src={image} alt={imageAlt} loading="eager" />
						{hoverImage && (
							<img
								class="card__image card__image--hover"
								src={hoverImage}
								alt={hoverImageAlt}
								loading="eager"
								aria-hidden={hoverImageAlt ? undefined : 'true'}
							/>
						)}
					</>
				)}
			</div>
		)
	}
	<div class="card__body">
		<div class="card__topline">
			{meta && <div class="card__meta">{meta}</div>}
			{
				allRoles.length > 0 && (
					<div class="card__roles">
						<span class="card__roles-trigger" aria-label={`All roles for ${title}`}>
							<span>All roles</span>
							<span class="card__roles-caret" aria-hidden="true"></span>
						</span>
						<div class="card__roles-popover">
							{allRoles.map((role) => <span>{role}</span>)}
						</div>
					</div>
				)
			}
		</div>
		<h3>
			{
				href ? (
					<a class="card__title-link" href={href}>
						<span class="card__title-text">
							<span>{title}</span>
							{titleIcon === 'steam' && (
								<img
									class="card__title-icon card__title-icon--image"
									src="/assets/icons/steam.png"
									alt="Steam"
								/>
							)}
							{titleIcon === 'itch' && (
								<img
									class="card__title-icon card__title-icon--image"
									src="/assets/icons/itch.png"
									alt="Itch.io"
								/>
							)}
							{platformIcons.length > 0 && (
								<span class="card__title-platforms" aria-label={`${title} platforms`}>
									{platformIcons.map((platform) => (
										<>
											{platform === 'windows' && (
												<img
													class="card__platform-icon card__platform-icon--image"
													src="/assets/icons/windows.png"
													alt="Windows"
												/>
											)}
											{platform === 'mac' && (
												<img
													class="card__platform-icon card__platform-icon--image"
													src="/assets/icons/apple.png"
													alt="macOS"
												/>
											)}
											{platform === 'browser' && (
												<img
													class="card__platform-icon card__platform-icon--image"
													src="/assets/icons/web.png"
													alt="Browser"
												/>
											)}
										</>
									))}
								</span>
							)}
						</span>
					</a>
				) : (
					<span class="card__title-text">
						<span>{title}</span>
						{titleIcon === 'steam' && (
							<img
								class="card__title-icon card__title-icon--image"
								src="/assets/icons/steam.png"
								alt="Steam"
							/>
						)}
						{titleIcon === 'itch' && (
							<img
								class="card__title-icon card__title-icon--image"
								src="/assets/icons/itch.png"
								alt="Itch.io"
							/>
						)}
						{platformIcons.length > 0 && (
							<span class="card__title-platforms" aria-label={`${title} platforms`}>
								{platformIcons.map((platform) => (
									<>
										{platform === 'windows' && (
											<img
												class="card__platform-icon card__platform-icon--image"
												src="/assets/icons/windows.png"
												alt="Windows"
											/>
										)}
										{platform === 'mac' && (
											<img
												class="card__platform-icon card__platform-icon--image"
												src="/assets/icons/apple.png"
												alt="macOS"
											/>
										)}
										{platform === 'browser' && (
											<img
												class="card__platform-icon card__platform-icon--image"
												src="/assets/icons/web.png"
												alt="Browser"
											/>
										)}
									</>
								))}
							</span>
						)}
					</span>
				)
			}
		</h3>
		<div>
			<slot />
		</div>
		{
			tags.length > 0 && (
				<div class="card__tags" aria-label={`${title} tags`}>
					{tags.map((tag) => <span class="tag">{tag}</span>)}
				</div>
			)
		}
		{
			links.length > 0 && (
				<div class="card__actions" aria-label={`${title} links`}>
					{links.map((link) => (
						<a href={link.href}>{link.label}</a>
					))}
				</div>
			)
		}
	</div>
</article>
